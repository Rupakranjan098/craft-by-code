Options -MultiViews -Indexes

# Block direct HTTP access to sensitive dotfiles, backups, database dumps, and lockfiles
<FilesMatch "(^\.|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan|.*\.sql|.*\.sqlite|.*\.zip|.*\.log|.*\.bak|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to internal application folders if docroot points to project root
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L,NC]
    RewriteRule (^|/)\. - [F,L]

    # Route all valid requests cleanly into public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
