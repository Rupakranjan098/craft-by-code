<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="pGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#8B5CF6" stop-opacity="0.2"/>
      <stop offset="100%" stop-color="#080D19" stop-opacity="0.9"/>
    </linearGradient>
  </defs>
  <rect width="800" height="500" rx="16" fill="#1E1B4B"/>
  <rect width="800" height="500" rx="16" fill="url(#pGrad)"/>
  
  <!-- Window Mockup -->
  <g transform="translate(40, 40)">
    <rect width="720" height="420" rx="12" fill="#020617" opacity="0.8" stroke="rgba(255,255,255,0.1)" stroke-width="1.5"/>
    <circle cx="30" cy="24" r="6" fill="#EF4444"/>
    <circle cx="50" cy="24" r="6" fill="#F59E0B"/>
    <circle cx="70" cy="24" r="6" fill="#10B981"/>
    
    <!-- Header bar -->
    <rect x="110" y="16" width="220" height="16" rx="4" fill="rgba(255,255,255,0.1)"/>
    <rect x="580" y="14" width="110" height="20" rx="10" fill="#8B5CF6" opacity="0.3"/>
    
    <!-- Mock UI Elements -->
    <rect x="30" y="60" width="200" height="120" rx="8" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.08)"/>
    <rect x="250" y="60" width="200" height="120" rx="8" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.08)"/>
    <rect x="470" y="60" width="220" height="120" rx="8" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.08)"/>
    
    <!-- Chart / Graphic area -->
    <rect x="30" y="200" width="660" height="190" rx="8" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.06)"/>
    
    <!-- Graphical bars or waves -->
    <path d="M 50 350 Q 150 240, 250 280 T 450 230 T 670 270" fill="none" stroke="#8B5CF6" stroke-width="4"/>
    <path d="M 50 350 Q 150 240, 250 280 T 450 230 T 670 270 L 670 380 L 50 380 Z" fill="#8B5CF6" opacity="0.15"/>
    
    <text x="50" y="105" fill="#94A3B8" font-family="system-ui, sans-serif" font-size="14">Mobile App</text>
    <text x="50" y="140" fill="#FFFFFF" font-family="system-ui, sans-serif" font-size="20" font-weight="bold">FitPulse Mobile App</text>
  </g>
</svg>